#!/usr/bin/env bash
printf '%s\n' "$*" >> "$RECORD/bunx"
case "$*" in
    *vite*)
        mkdir -p dist/web
        printf '<!doctype html>\n' > dist/web/index.html
        ;;
    *tauri*)
        if [[ -n "${BUILD_FAILS:-}" ]]; then
            echo "the build stopped"
            exit 3
        fi
        if [[ -n "${EDIT_DURING_BUILD:-}" ]]; then
            printf '\n' >> ../src/web/index.html
        fi
        mkdir -p ../target/release
        printf '#!/usr/bin/env bash\n' > ../target/release/pdf-bucket-desktop
        ;;
    "wxt build -b firefox")
        mkdir -p dist/firefox-mv2
        printf '{"name": "Math PDF Reader", "version": "1.0.1"}\n' > dist/firefox-mv2/manifest.json
        ;;
    "wxt build")
        mkdir -p dist/chrome-mv3
        printf '{"name": "Math PDF Reader", "version": "1.0.1"}\n' > dist/chrome-mv3/manifest.json
        ;;
    "web-ext sign"*)
        while [[ $# -gt 0 && "$1" != --artifacts-dir ]]; do shift; done
        printf 'signed\n' > "$2/signed.xpi"
        ;;
esac
