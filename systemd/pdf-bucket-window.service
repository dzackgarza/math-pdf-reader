# Rendered and installed by `just provision`; @NAME@ placeholders are filled in there.
[Unit]
Description=PDF Bucket window on @ORIGIN@
Documentation=file://@REPO@/docs/m5.md
Requires=pdf-bucket.service
After=pdf-bucket.service graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
# The window opens once the server answers; a server that never answers fails this unit.
ExecStartPre=/usr/bin/curl --silent --show-error --fail --output /dev/null --retry 30 --retry-delay 1 --retry-connrefused @ORIGIN@/status
ExecStart=%h/.local/bin/pdf-bucket-desktop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
