{
  "name": "pdf-bucket",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config src/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/contract && tsc --noEmit -p src/web && tsc --noEmit -p src/extension && tsc --noEmit -p tests",
    "test": "bun test --timeout 15000",
    "coverage": "bun test --timeout 15000 --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "postinstall": "wxt prepare",
    "cache-evidence": "bun tests/cache-evidence.ts"
  },
  "dependencies": {
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/fonts-arabic": "1.0.0",
    "@embedpdf/fonts-hebrew": "1.0.0",
    "@embedpdf/fonts-jp": "1.0.0",
    "@embedpdf/fonts-kr": "1.0.0",
    "@embedpdf/fonts-latin": "1.0.0",
    "@embedpdf/fonts-sc": "1.0.0",
    "@embedpdf/fonts-tc": "1.0.0",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/react-pdf-viewer": "^2.15.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "2",
    "@tauri-apps/plugin-dialog": "2",
    "@tauri-apps/plugin-opener": "2",
    "async-mutex": "^0.5.0",
    "cmdk": "^1.1.1",
    "content-disposition": "^3.0.0",
    "decode-uri-component": "^0.5.0",
    "fzf": "^0.5.2",
    "lucide": "^1.52.0",
    "lucide-react": "^1.47.0",
    "p-timeout": "^7.0.2",
    "pretty-bytes": "^7.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "whatwg-mimetype": "^5.0.0",
    "wouter": "^3.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/whatwg-mimetype": "^5.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "5",
    "linkedom": "^0.18.13",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
