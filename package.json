{
  "name": "pdf-bucket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "build": "vite build --config src/web/vite.config.ts && wxt build && wxt build -b firefox",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/server && tsc --noEmit -p src/web && tsc --noEmit -p src/extension && tsc --noEmit -p tests",
    "test": "bun test",
    "coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-table": "^8.21.3",
    "cmdk": "^1.1.1",
    "fzf": "^0.5.2",
    "content-disposition": "^3.0.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "pretty-bytes": "^7.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "^3.11.0",
    "xdg-basedir": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
