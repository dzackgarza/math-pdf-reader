{
  "server": {
    "host": "127.0.0.1",
    "port": 8770
  },
  "capture": {
    "min_frame_width": 700,
    "min_frame_height": 350,
    "link_origin_max_age_seconds": 300,
    "native_open_timeout_seconds": 10,
    "firefox_addon_id": "pdf-bucket@dzackgarza.com"
  },
  "zotero": {
    "url": "http://127.0.0.1:23119"
  },
  "rebuild": {
    "concurrent_downloads": 4,
    "download_timeout_seconds": 120
  },
  "plugins": {
    "extraction_timeout_seconds": 1800,
    "send_extraction_chain": [
      "arxiv-source",
      "mineru-flash",
      "mistral-ocr",
      "mineru-precise"
    ]
  },
  "ai": {
    "binary": "opencode",
    "port": 4099,
    "model": "opencode/deepseek-v4.1-flash-free",
    "startup_timeout_seconds": 30
  },
  "store": {
    "command_timeout_seconds": 120
  },
  "arxiv": {
    "api_url": "https://export.arxiv.org/api/query",
    "abs_url": "https://arxiv.org/abs/",
    "pdf_url": "https://arxiv.org/pdf/",
    "e_print_url": "https://arxiv.org/e-print/",
    "request_interval_seconds": 3
  }
}
