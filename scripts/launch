#!/usr/bin/env bash
set -euo pipefail
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
data="${XDG_DATA_HOME:-$HOME/.local/share}"
stamp="$data/pdf-bucket-app/source-fingerprint"
app="$HOME/.local/bin/pdf-bucket-desktop"

fail() {
    printf 'pdf-bucket: %s\n' "$1" >&2
    notify-send -u critical "Math PDF Reader" "$1" 2> /dev/null || true
    exit 1
}

rebuild_in_terminal() {
    command -v kitty > /dev/null ||
        fail "kitty is required to show the rebuild output"
    kitty --title "Math PDF Reader - Building" bash -c '
        set +e -o pipefail
        repo="$1" installed="$2"
        just --justfile "$repo/justfile" --working-directory "$repo" provision-for-launch 2>&1 |
            tee "$installed/rebuild.log"
        status=$?
        if (( status != 0 )); then
            printf "%d\n" "$status" > "$installed/rebuild-failure"
            printf "\nRebuild failed (exit %d). Press Enter to close.\n" "$status"
            read -r
        fi
        exit "$status"
    ' bash "$repo" "$data/pdf-bucket-app"
}

mkdir -p "$data/pdf-bucket-app"
exec 9> "$data/pdf-bucket-app/launch.lock"
flock 9
if [[ ! -x "$app" || ! -f "$stamp" || "$(< "$stamp")" != "$("$repo/scripts/source-fingerprint")" ]]; then
    notify-send "Math PDF Reader" "Source changed: rebuilding before launch" 2> /dev/null || true
    rebuild_in_terminal ||
        fail "rebuild failed; see the Math PDF Reader build terminal for details"
fi
flock -u 9
exec 9>&-
exec "$app" "$@"
