{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Bucket",
  "version": "0.1.0",
  "identifier": "com.dzackgarza.pdfbucket",
  "build": {
    "beforeDevCommand": "bun run --filter @pdf-bucket/server dev",
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PDF Bucket",
        "url": "http://127.0.0.1:8765",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
